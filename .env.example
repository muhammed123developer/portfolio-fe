# ---------------------------------------------------------------------------
# Frontend environment variables
#
# Copy to `.env`:  cp .env.example .env
#
# WARNING: every VITE_* variable is inlined into the JavaScript bundle and is
# therefore PUBLIC. Never put a secret here — no database URL, no JWT secret,
# no admin password. Those live in backend/.env and never leave the server.
# ---------------------------------------------------------------------------

# Base URL of the REST API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Used for canonical URLs and Open Graph tags. Set to the real domain in prod.
VITE_SITE_URL=http://localhost:5173
